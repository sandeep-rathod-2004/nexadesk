APP_NAME=NexaDesk API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./nexadesk.db
GENERATION_COORDINATION_BACKEND=local
REDIS_URL=
GENERATION_LEASE_SECONDS=60
GENERATION_COORDINATION_POLL_SECONDS=0.5
AI_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=15
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_READ_TIMEOUT_SECONDS=600
OLLAMA_KEEP_ALIVE=15m
OLLAMA_EMBEDDING_KEEP_ALIVE=5m
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_MESSAGE_CHARS=4000
DOCUMENT_STORAGE_BACKEND=local
KNOWLEDGE_STORAGE_PATH=data/knowledge
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_CONNECT_TIMEOUT_SECONDS=5
R2_READ_TIMEOUT_SECONDS=60
KNOWLEDGE_MAX_FILE_SIZE_BYTES=10485760
KNOWLEDGE_MAX_PDF_PAGES=300
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_RETRIEVAL_COUNT=5
KNOWLEDGE_MIN_SIMILARITY=0.35
